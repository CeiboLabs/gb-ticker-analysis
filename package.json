{
  "name": "ticker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --experimental-https -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test lib/*.test.ts lib/*.test.tsx",
    "test:int": "INTEGRATION=1 tsx --test lib/*.test.ts lib/*.test.tsx",
    "pages:build": "npx @cloudflare/next-on-pages",
    "pages:deploy": "npm run pages:build && npx wrangler pages deploy",
    "pages:preview": "npm run pages:build && npx wrangler pages dev",
    "fondo:build": "tsx scripts/build-fondo.mts",
    "fondo:dev": "npm run fondo:build && npx -y wrangler@4.118.0 dev --config workers/fondo-site/wrangler.jsonc",
    "fondo:deploy": "npm run fondo:build && npx -y wrangler@4.118.0 deploy --config workers/fondo-site/wrangler.jsonc"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.3.2",
    "@tailwindcss/typography": "^0.5.19",
    "@types/d3-sankey": "^0.12.5",
    "better-sqlite3": "^12.11.1",
    "d3-sankey": "^0.12.3",
    "framer-motion": "^12.40.0",
    "lenis": "^1.3.23",
    "lightweight-charts": "^5.1.0",
    "next": "^16.2.6",
    "openai": "^6.33.0",
    "postal-mime": "^2.7.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "uqr": "^0.1.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yahoo-finance2": "^3.14.0",
    "zod": "^4.3.6"
  },
  "overrides": {
    "@deno/shim-deno": "file:./lib/deno-shim-edge"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "puppeteer-core": "^25.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
